POSTGRES_DB=goofyrider
POSTGRES_USER=goofyrider_user
POSTGRES_PASSWORD=goofyrider_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional override. If omitted, backend builds DATABASE_URL from POSTGRES_* values.
DATABASE_URL=postgresql+psycopg://goofyrider_user:goofyrider_password@localhost:5432/goofyrider

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
