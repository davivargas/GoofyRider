<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds talk to a local backend over plain HTTP (10.0.2.2 or a LAN IP). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
